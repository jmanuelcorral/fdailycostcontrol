# =============================================================================
# fdailyCostControl — Variables de entorno
# =============================================================================
# Copiar este fichero como .env o usar los valores en local.settings.json
# Para Azure: configurar como App Settings en la Function App
# =============================================================================

# ---------------------------------------------------------------------------
# Azure Subscription
# ---------------------------------------------------------------------------
# ID de la suscripción Azure a monitorizar
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Autenticación (solo desarrollo local — Service Principal)
# En Azure se usa Managed Identity automáticamente, no hacen falta estas vars.
# ---------------------------------------------------------------------------
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=tu-client-secret-aqui

# ---------------------------------------------------------------------------
# Storage Account
# ---------------------------------------------------------------------------
# Connection string de la Storage Account (usado para Table Storage / cooldown)
# Local: "UseDevelopmentStorage=true" (requiere Azurite corriendo)
# Azure: se configura automáticamente con la Storage Account vinculada
AzureWebJobsStorage=UseDevelopmentStorage=true

# ---------------------------------------------------------------------------
# Monitorización de costes
# ---------------------------------------------------------------------------
# JSON array con los Resource Groups a monitorizar y sus umbrales de coste diario.
#
# Campos por entrada:
#   resource_group (string, obligatorio): Nombre del Resource Group
#   threshold (float, opcional, default 0.0): Coste diario máximo en la moneda indicada
#   currency (string, opcional, default "EUR"): Moneda para referencia
#
# Ejemplo con múltiples RGs:
COST_MONITOR_CONFIG=[{"resource_group": "rg-produccion", "threshold": 50.0, "currency": "EUR"}, {"resource_group": "rg-staging", "threshold": 20.0, "currency": "EUR"}, {"resource_group": "rg-dev", "threshold": 10.0, "currency": "EUR"}]

# ---------------------------------------------------------------------------
# Webhook endpoints (Pandora FMS)
# ---------------------------------------------------------------------------
# JSON array con los endpoints a los que enviar alertas cuando se supere un umbral.
#
# Campos por entrada:
#   url (string, obligatorio): URL del webhook
#   method (string, opcional, default "POST"): Método HTTP — "POST" o "GET"
#   headers (object, opcional): Headers HTTP adicionales (ej: Authorization)
#
# Con POST: envía un JSON body con los datos de la alerta.
# Con GET: envía los datos como query parameters en la URL.
#
# Ejemplo con múltiples endpoints:
WEBHOOK_ENDPOINTS=[{"url": "https://pandora.miempresa.com/api/webhook/cost-alert", "method": "POST", "headers": {"Authorization": "Bearer mi-token-aqui"}}, {"url": "https://pandora.miempresa.com/api/alert", "method": "GET"}]

# ---------------------------------------------------------------------------
# Control de alertas duplicadas (cooldown)
# ---------------------------------------------------------------------------
# Minutos mínimos entre alertas consecutivas para el mismo Resource Group.
# Evita spam de notificaciones cuando el coste se mantiene por encima del umbral.
# Default: 60 (1 hora)
ALERT_COOLDOWN_MINUTES=60

# ---------------------------------------------------------------------------
# Azure Functions runtime (no modificar)
# ---------------------------------------------------------------------------
FUNCTIONS_WORKER_RUNTIME=python
